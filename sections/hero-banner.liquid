<!-- Hero Section -->
<section class="hero-section">
  <div class="site-wrapper">
    <div class="hero-grid">
      
      <!-- Left Hero Content -->
      <div class="hero-content">
        <!-- Botanical branch line illustration -->
        <svg class="botanical-accent-left" viewBox="0 0 100 160" fill="none" stroke="#9BB0A5" stroke-width="1.2">
          <path d="M50 150 C 45 100, 50 60, 30 10" />
          <path d="M48 120 C 35 110, 20 115, 15 105 C 12 98, 25 95, 45 108" fill="#E6EFEA" opacity="0.7"/>
          <path d="M49 90 C 65 80, 78 85, 82 76 C 85 70, 70 65, 48 78" fill="#E6EFEA" opacity="0.7"/>
          <path d="M45 60 C 30 50, 18 55, 14 47 C 12 40, 24 38, 43 50" fill="#E6EFEA" opacity="0.7"/>
          <path d="M40 30 C 50 20, 60 22, 62 16 C 63 12, 52 10, 36 22" fill="#E6EFEA" opacity="0.7"/>
          <circle cx="30" cy="10" r="2.5" fill="#9BB0A5"/>
          <circle cx="75" cy="50" r="2" fill="#D99C94"/>
        </svg>

        <span class="hero-subtitle-tag">{{ section.settings.subtitle | default: 'NEW SEASON COLLECTION' }}</span>
        <h1 class="hero-title">{{ section.settings.title | default: 'Live Beautifully.<br>Shop Effortlessly.' }}</h1>
        <p class="hero-desc">{{ section.settings.description | default: 'Curated styles, quality you love, delivered to your door.' }}</p>
        
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn-primary" id="hero-shop-now-btn">
          <span>{{ section.settings.button_text | default: 'Shop Now' }}</span>
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>

        <!-- 3 Trust Badges Under Hero -->
        <div class="hero-trust-badges">
          <!-- Free Shipping -->
          <div class="hero-trust-item">
            <div class="trust-icon-circle yellow">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 17h8M5 17h-2v-9a2 2 0 012-2h10a2 2 0 012 2v9h-2m-12 0a2 2 0 104 0 2 2 0 00-4 0zm12 0a2 2 0 104 0 2 2 0 00-4 0zM17 9h4l2 4v4h-2"/>
              </svg>
            </div>
            <div class="trust-item-text">
              <span class="trust-item-title">Free Shipping</span>
              <span class="trust-item-sub">On orders over $50</span>
            </div>
          </div>

          <!-- Secure Payment -->
          <div class="hero-trust-item">
            <div class="trust-icon-circle sage">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div class="trust-item-text">
              <span class="trust-item-title">Secure Payment</span>
              <span class="trust-item-sub">100% protected</span>
            </div>
          </div>

          <!-- Easy Returns -->
          <div class="hero-trust-item">
            <div class="trust-icon-circle blush">
              <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
            </div>
            <div class="trust-item-text">
              <span class="trust-item-title">Easy Returns</span>
              <span class="trust-item-sub">30-day return</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Hero Media -->
      <div class="hero-media-wrapper">
        <svg class="hero-botanical-right" viewBox="0 0 120 180" fill="none" stroke="#7E968A" stroke-width="1.2">
          <path d="M110 10 C 90 40, 70 80, 85 160" />
          <path d="M100 30 C 70 25, 60 38, 62 48 C 65 55, 78 52, 95 40" fill="#CBD8D1" opacity="0.65"/>
          <path d="M90 60 C 115 65, 120 78, 115 86 C 110 92, 98 88, 86 72" fill="#CBD8D1" opacity="0.65"/>
          <path d="M84 95 C 55 95, 48 110, 52 120 C 58 126, 70 120, 83 105" fill="#CBD8D1" opacity="0.65"/>
          <path d="M82 130 C 105 135, 110 148, 105 156 C 98 162, 90 156, 84 140" fill="#CBD8D1" opacity="0.65"/>
        </svg>

        <!-- Arched Blush Frame with Model -->
        <div class="hero-arch-container">
          <img src="{{ 'hero-model.jpg' | asset_url }}" alt="Lumora Spring Summer Collection Model in Sage Dress" class="hero-model-img">
        </div>

        <!-- Floating Luxe Handbag Product Card -->
        <div class="floating-product-card" id="floating-hero-card">
          <div class="floating-card-image-wrap">
            <img src="{{ 'luxe-handbag.jpg' | asset_url }}" alt="Luxe Structured Handbag">
            <button class="floating-wishlist-btn wishlist-toggle active" data-id="luxe-handbag" aria-label="Toggle Wishlist">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </button>
          </div>

          <div class="floating-card-info">
            <div class="floating-card-title">Luxe Handbag</div>
            <div class="floating-card-price">$129.00</div>
          </div>

          <div class="floating-card-actions">
            <button class="floating-add-cart add-to-cart-btn" data-id="luxe-handbag">Add to Cart</button>
            <a href="/products/luxe-handbag" class="floating-quick-plus" aria-label="View Details">+</a>
          </div>

          <div class="floating-card-dots">
            <span class="active"></span>
            <span></span>
            <span></span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Tag",
      "default": "NEW SEASON COLLECTION"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Hero Title",
      "default": "Live Beautifully.<br>Shop Effortlessly."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Curated styles, quality you love, delivered to your door."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
