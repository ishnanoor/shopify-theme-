<!-- Breadcrumb -->
<div class="site-wrapper">
  <nav class="breadcrumbs-bar" aria-label="Breadcrumb">
    <ol class="breadcrumbs-list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li class="breadcrumbs-separator">/</li>
      <li class="breadcrumbs-current" aria-current="page">Contact Us & Concierge</li>
    </ol>
  </nav>
</div>

<!-- Contact Page Layout -->
<section class="site-wrapper contact-page-section">
  <div class="contact-layout-grid">
    
    <!-- Left: Concierge Details & Channels -->
    <div class="contact-info-panel">
      <span style="color: var(--color-blush); font-weight: 700; letter-spacing: 0.14em; font-size: 0.8rem; text-transform: uppercase;">AT YOUR SERVICE</span>
      <h2>Connect with Our Atelier</h2>
      <p class="lead">Whether you are looking for custom styling advice, delivery assistance, or would like to schedule a private viewing in our atelier, we are delighted to assist you.</p>

      <div class="contact-cards-stack">
        <!-- Digital Concierge -->
        <div class="contact-channel-card">
          <div class="channel-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="channel-detail">
            <h4>Digital Concierge</h4>
            <p>Typical response within 4 hours during business days.</p>
            <a href="mailto:{{ shop.email | default: 'concierge@lumora.com' }}">{{ shop.email | default: 'concierge@lumora.com' }}</a>
          </div>
        </div>

        <!-- Phone & WhatsApp -->
        <div class="contact-channel-card">
          <div class="channel-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div class="channel-detail">
            <h4>Client Services</h4>
            <p>Monday &ndash; Saturday: 9:00 AM &ndash; 7:00 PM EST</p>
            <a href="tel:+18004820198">+1 (800) 482-0198</a>
          </div>
        </div>

        <!-- Flagship Atelier -->
        <div class="contact-channel-card">
          <div class="channel-icon">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div class="channel-detail">
            <h4>Flagship Atelier</h4>
            <p>482 Mercer Street, SoHo, New York, NY 10013</p>
            <span style="font-size: 0.8rem; color: var(--color-primary); font-weight: 600;">Private appointments available upon request</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Message Form -->
    <div class="contact-form-box">
      <h3>Transmit an Inquiry</h3>
      <p class="form-sub">Please complete the form below. We will attend to your request with the utmost care.</p>

      {% form 'contact', id: 'lumora-contact-form' %}
        {% if form.posted_successfully? %}
          <p style="color: #3B7258; background: #EAF5EE; padding: 12px; border-radius: 6px; margin-bottom: 16px;">Thank you for contacting us. Our concierge will attend to your message shortly.</p>
        {% endif %}

        {% if form.errors %}
          <p style="color: #C2410C; background: #FFEDD5; padding: 12px; border-radius: 6px; margin-bottom: 16px;">Please check the required fields and submit again.</p>
        {% endif %}

        <div class="form-grid-2">
          <div class="form-group">
            <label for="ContactFormName">Full Name *</label>
            <input type="text" id="ContactFormName" name="contact[name]" required placeholder="e.g. Clara Sterling">
          </div>
          <div class="form-group">
            <label for="ContactFormEmail">Email Address *</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" required placeholder="clara@example.com">
          </div>
        </div>

        <div class="form-group">
          <label for="ContactFormPhone">Phone / Order Reference</label>
          <input type="text" id="ContactFormPhone" name="contact[phone]" placeholder="e.g. #LUM-84920">
        </div>

        <div class="form-group">
          <label for="ContactFormMessage">How can we assist you? *</label>
          <textarea id="ContactFormMessage" name="contact[body]" rows="5" required placeholder="Share details about your question or requested consultation..."></textarea>
        </div>

        <button type="submit" class="btn-primary" style="width: 100%; padding: 16px; margin-top: 10px;">
          <span>Send Message to Concierge</span>
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>
      {% endform %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": []
}
{% endschema %}
