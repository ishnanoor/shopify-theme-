<!-- Header Navigation -->
<header class="site-header">
  <div class="site-wrapper">
    <div class="header-container">
      
      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="brand-logo" id="header-brand-logo">
        <svg class="brand-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C12.5 5.5 14 7 17.5 7.5C14 8 12.5 9.5 12 13C11.5 9.5 10 8 6.5 7.5C10 7 11.5 5.5 12 2Z" />
          <path d="M12 11C12.5 14.5 14 16 17.5 16.5C14 17 12.5 18.5 12 22C11.5 18.5 10 17 6.5 16.5C10 16 11.5 14.5 12 11Z" opacity="0.85"/>
          <circle cx="12" cy="12" r="2.2" />
        </svg>
        <span class="brand-name">{{ section.settings.logo_text | default: shop.name }}</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="main-nav" id="main-navigation">
        {% if section.settings.menu != blank and linklists[section.settings.menu].links.size > 0 %}
          {% for link in linklists[section.settings.menu].links %}
            <a href="{{ link.url }}" class="nav-link {% if link.active %}active{% endif %}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a href="{{ routes.all_products_collection_url }}" class="nav-link active">Shop</a>
          <a href="#categories" class="nav-link">Collections</a>
          <a href="#new-arrivals" class="nav-link">New Arrivals</a>
          <a href="#deals" class="nav-link">Deals</a>
          <a href="/pages/about" class="nav-link">About</a>
          <a href="/blogs/news" class="nav-link">Journal</a>
          <a href="/pages/contact" class="nav-link">Contact</a>
        {% endif %}
      </nav>

      <!-- Header Actions -->
      <div class="header-actions">
        <!-- Search Icon Button -->
        <button class="action-btn search-trigger-btn" id="search-open-btn" aria-label="Search Catalog">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- User Account Button -->
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="action-btn" id="user-account-btn" aria-label="Customer Account">
          <svg width="21" height="21" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </a>

        <!-- Shopping Bag Button with Badge -->
        <button class="action-btn cart-trigger-btn" id="cart-open-btn" aria-label="View Shopping Bag">
          <svg width="21" height="21" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="cart-count-badge" id="cart-counter">{{ cart.item_count | default: 2 }}</span>
        </button>

        <!-- Mobile Hamburger Toggle -->
        <button class="mobile-menu-toggle" id="mobile-menu-btn" aria-label="Toggle navigation menu">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Brand Logo Text",
      "default": "LUMORA"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
