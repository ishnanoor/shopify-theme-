<div class="site-wrapper" style="text-align: center; padding: 100px 20px 120px; max-width: 600px; margin: 0 auto;">
  <span style="font-family: var(--font-heading); font-size: 6rem; color: var(--color-primary); line-height: 1; display: block; margin-bottom: 12px;">404</span>
  <h1 style="font-family: var(--font-heading); font-size: 2.2rem; margin-bottom: 16px;">This Piece Cannot Be Found</h1>
  <p style="color: var(--color-text-muted); font-size: 1.05rem; margin-bottom: 30px;">
    The page you are looking for may have been retired, renamed, or temporarily relocated.
  </p>
  <a href="{{ routes.root_url }}" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
    <span>Return to Lumora Home</span>
    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
    </svg>
  </a>
</div>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
