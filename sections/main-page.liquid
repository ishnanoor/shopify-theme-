<div class="site-wrapper" style="padding: 50px 0 80px; max-width: 800px; margin: 0 auto;">
  <h1 style="font-family: var(--font-heading); font-size: 2.6rem; color: var(--color-primary); margin-bottom: 24px; text-align: center;">
    {{ page.title }}
  </h1>
  <div class="rte" style="line-height: 1.8; color: var(--color-text-body); font-size: 1.05rem;">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
