<div class="site-wrapper" style="padding: 50px 0 80px; max-width: 800px; margin: 0 auto;">
  <h1 style="font-family: var(--font-heading); font-size: 2.8rem; color: var(--color-primary); margin-bottom: 30px; text-align: center;">
    {{ 'general.cart.title' | t }}
  </h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      <div style="background: #FFF; border-radius: var(--radius-md); padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); margin-bottom: 24px;">
        {% for item in cart.items %}
          <div style="display: flex; gap: 20px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--color-border);">
            <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title | escape }}" style="width: 80px; height: 95px; object-fit: cover; border-radius: var(--radius-sm);">
            <div style="flex: 1;">
              <h3 style="font-size: 1.1rem; margin-bottom: 4px;"><a href="{{ item.url }}" style="color: var(--color-text-title); text-decoration: none;">{{ item.product.title }}</a></h3>
              {% unless item.variant.title contains 'Default' %}
                <div style="font-size: 0.85rem; color: var(--color-text-muted);">{{ item.variant.title }}</div>
              {% endunless %}
              <div style="font-weight: 600; color: var(--color-primary); margin-top: 6px;">{{ item.final_line_price | money }}</div>
            </div>
            <div>
              <span style="font-size: 0.9rem; color: var(--color-text-muted);">Qty: {{ item.quantity }}</span>
            </div>
          </div>
        {% endfor %}
      </div>

      <div style="text-align: right; background: #FFF; border-radius: var(--radius-md); padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
        <div style="font-size: 1.3rem; font-weight: 700; color: var(--color-primary); margin-bottom: 8px;">
          {{ 'general.cart.subtotal' | t }}: {{ cart.total_price | money }}
        </div>
        <p style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 20px;">{{ 'general.cart.taxes_included_shipping_at_checkout' | t }}</p>
        <button type="submit" name="checkout" class="btn-primary" style="padding: 14px 32px; font-size: 1rem;">
          {{ 'general.cart.checkout' | t }}
        </button>
      </div>
    </form>
  {% else %}
    <div style="text-align: center; padding: 60px 20px; background: #FFF; border-radius: var(--radius-md); box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
      <p style="font-size: 1.2rem; color: var(--color-text-muted); margin-bottom: 24px;">{{ 'general.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-primary">Explore Collections</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
