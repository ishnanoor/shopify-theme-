<div class="site-wrapper" style="padding-top: 40px; padding-bottom: 60px;">
  <div class="section-head" style="margin-bottom: 30px; text-align: center; display: block;">
    <h1 style="font-family: var(--font-heading); font-size: 2.6rem; color: var(--color-primary); margin-bottom: 8px;">
      {{ collection.title | default: 'Curated Collections' }}
    </h1>
    {% if collection.description != blank %}
      <p style="max-width: 600px; margin: 0 auto; color: var(--color-text-muted);">{{ collection.description }}</p>
    {% endif %}
  </div>

  {% paginate collection.products by 12 %}
    <div class="products-grid-5">
      {% if collection.products.size > 0 %}
        {% for product in collection.products %}
          <div class="product-card">
            <div class="product-thumb-wrap">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>
              <button class="card-wishlist-btn wishlist-toggle" data-id="{{ product.id }}" aria-label="Add to wishlist">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </button>
              <button class="product-quick-add add-to-cart-btn" data-id="{{ product.id }}">Quick Add +</button>
            </div>
            <div class="product-meta">
              <a href="{{ product.url }}" class="product-title">{{ product.title }}</a>
              <div class="product-price-row">
                <span class="product-price">{{ product.price | money }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Fallback Default Showcase Items -->
        <div class="product-card">
          <div class="product-thumb-wrap">
            <a href="/products/luxe-handbag"><img src="{{ 'luxe-handbag.jpg' | asset_url }}" alt="Luxe Handbag"></a>
            <button class="product-quick-add add-to-cart-btn" data-id="luxe-handbag">Quick Add +</button>
          </div>
          <div class="product-meta"><a href="/products/luxe-handbag" class="product-title">Luxe Handbag</a><span class="product-price">$129.00</span></div>
        </div>
        <div class="product-card">
          <div class="product-thumb-wrap">
            <a href="/products/linen-shirt"><img src="{{ 'linen-shirt.jpg' | asset_url }}" alt="Linen Shirt"></a>
            <button class="product-quick-add add-to-cart-btn" data-id="linen-shirt">Quick Add +</button>
          </div>
          <div class="product-meta"><a href="/products/linen-shirt" class="product-title">Linen Shirt</a><span class="product-price">$49.00</span></div>
        </div>
        <div class="product-card">
          <div class="product-thumb-wrap">
            <a href="/products/minimal-sneakers"><img src="{{ 'sneakers.jpg' | asset_url }}" alt="Sneakers"></a>
            <button class="product-quick-add add-to-cart-btn" data-id="minimal-sneakers">Quick Add +</button>
          </div>
          <div class="product-meta"><a href="/products/minimal-sneakers" class="product-title">Minimal Sneakers</a><span class="product-price">$79.00</span></div>
        </div>
        <div class="product-card">
          <div class="product-thumb-wrap">
            <a href="/products/scented-candle"><img src="{{ 'candle.jpg' | asset_url }}" alt="Candle"></a>
            <button class="product-quick-add add-to-cart-btn" data-id="scented-candle">Quick Add +</button>
          </div>
          <div class="product-meta"><a href="/products/scented-candle" class="product-title">Scented Candle</a><span class="product-price">$26.00</span></div>
        </div>
        <div class="product-card">
          <div class="product-thumb-wrap">
            <a href="/products/gold-hoops"><img src="{{ 'gold-hoops.jpg' | asset_url }}" alt="Gold Hoops"></a>
            <button class="product-quick-add add-to-cart-btn" data-id="gold-hoops">Quick Add +</button>
          </div>
          <div class="product-meta"><a href="/products/gold-hoops" class="product-title">Gold Hoops</a><span class="product-price">$19.00</span></div>
        </div>
      {% endif %}
    </div>

    {% if paginate.pages > 1 %}
      <div style="text-align: center; margin-top: 40px;">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
