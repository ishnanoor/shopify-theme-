<!-- Quick Search Modal -->
<div class="search-modal-overlay" id="search-modal">
  <div class="search-modal-box">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-input-header">
      <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-text-muted);">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" id="search-input" autocomplete="off">
      <button type="button" class="search-close-btn" style="font-size: 1.25rem; color: var(--color-text-muted); background: none; border: none; cursor: pointer;">✕</button>
    </form>
    <div class="search-results-pane" id="search-results">
      <div style="font-size: 0.88rem; color: var(--color-text-muted); margin-bottom: 12px;">{{ 'general.search.trending' | t }}</div>
      <div class="trending-pills">
        <a href="{{ routes.all_products_collection_url }}" class="trend-pill">Luxe Handbag</a>
        <a href="{{ routes.all_products_collection_url }}" class="trend-pill">Linen Shirts</a>
        <a href="{{ routes.all_products_collection_url }}" class="trend-pill">Gold Hoops</a>
        <a href="{{ routes.all_products_collection_url }}" class="trend-pill">Amber Candles</a>
        <a href="{{ routes.all_products_collection_url }}" class="trend-pill">Straw Boater</a>
      </div>
    </div>
  </div>
</div>
