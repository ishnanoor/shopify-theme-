<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#2D4030">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {{ content_for_header }}

  {{ 'style.css' | asset_url | stylesheet_tag }}
  {{ 'pages.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-{{ template.name | handle }}">

  <!-- Top Announcement Bar Section -->
  {% section 'announcement-bar' %}

  <!-- Site Header Section -->
  {% section 'header' %}

  <!-- Main Content Layout -->
  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- Footer Section -->
  {% section 'footer' %}

  <!-- Slide-Out Shopping Bag Drawer -->
  {% render 'cart-drawer' %}

  <!-- Quick Search Modal -->
  {% render 'search-modal' %}

  <!-- Toast Notification System -->
  {% render 'toast' %}

  <!-- Scripts -->
  <script>
    window.ShopifyTheme = {
      assetUrl: "{{ '' | asset_url }}",
      shopUrl: "{{ shop.url }}",
      routes: {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}'
      }
    };
  </script>
  {{ 'data.js' | asset_url | script_tag }}
  {{ 'main.js' | asset_url | script_tag }}
</body>
</html>
